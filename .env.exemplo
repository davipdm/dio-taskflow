# Copie para .env na raiz. Nunca publique o arquivo preenchido.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
# Alias configurável; confira disponibilidade e cota no AI Studio.
GEMINI_MODEL=gemini-flash-latest
TRELLO_API_KEY=
TRELLO_API_SECRET=
TRELLO_TOKEN=
# Preferência: ID do quadro. Sem ID, o nome abaixo deve ser único na conta.
TRELLO_BOARD_ID=
TRELLO_BOARD_NAME=DIO TaskFlow
APP_TIMEZONE=America/Sao_Paulo
